<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SCP_035Exposure</defName><label>SCP-035's call</label>
    <description>Time spent seeing the mask. The urge to wear it keeps growing.</description>
    <isBad>true</isBad><initialSeverity>0.01</initialSeverity><maxSeverity>1</maxSeverity>
    <stages><li><label>drawn to the mask</label></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>SCP_035HostDecay</defName><label>SCP-035 host decay</label>
    <description>The mask controls its host while the body decomposes. After two hours the brain is destroyed.</description>
    <isBad>true</isBad><initialSeverity>0.01</initialSeverity><maxSeverity>1</maxSeverity>
    <stages>
      <li><minSeverity>0</minSeverity><label>early decay</label><statFactors><IncomingDamageFactor>0.4</IncomingDamageFactor></statFactors></li>
      <li><minSeverity>0.5</minSeverity><label>advanced decay</label><painFactor>1.3</painFactor><statFactors><IncomingDamageFactor>0.4</IncomingDamageFactor></statFactors></li>
    </stages>
  </HediffDef>
</Defs>
