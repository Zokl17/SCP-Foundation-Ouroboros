<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SCP_AmnesticConfusion</defName>
    <label>amnestic confusion</label>
    <description>Temporary disorientation and slowed cognition caused by a Foundation Class-A amnestic.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><initialSeverity>1</initialSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>15000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><capMods><li><capacity>Consciousness</capacity><offset>-0.10</offset></li><li><capacity>Manipulation</capacity><offset>-0.05</offset></li></capMods></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>SCP_MnesticStabilization</defName>
    <label>mnestic stabilization</label>
    <description>Cognitive reinforcement from a Foundation mnestic compound. Psychic influence is dampened and mental stability is improved.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>false</isBad><initialSeverity>1</initialSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><statOffsets><PsychicSensitivity>-0.40</PsychicSensitivity><MentalBreakThreshold>-0.08</MentalBreakThreshold></statOffsets></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>SCP_TranqSedation</defName>
    <label>tranquilizer sedation</label>
    <description>A fast-acting Foundation tranquilizer is suppressing the subject's central nervous system. Additional doses deepen sedation; the required amount depends on body size.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>45000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-0.8</severityPerDay></li>
    </comps>
    <stages>
      <li>
        <label>trace</label>
        <capMods><li><capacity>Consciousness</capacity><offset>-0.05</offset></li></capMods>
      </li>
      <li>
        <minSeverity>0.34</minSeverity><label>sedated</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.25</offset></li>
          <li><capacity>Moving</capacity><offset>-0.15</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.67</minSeverity><label>incapacitated</label>
        <capMods><li><capacity>Consciousness</capacity><setMax>0.1</setMax></li></capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SCP_ContainmentNetting</defName>
    <label>containment netting</label>
    <description>Weighted Foundation restraint cables have wrapped around the target. Human-sized and smaller targets are immobilized, while larger bodies are slowed until enough net mass accumulates.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><maxSeverity>2</maxSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>7500</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages>
      <li>
        <label>entangled</label>
        <capMods><li><capacity>Moving</capacity><offset>-0.35</offset></li><li><capacity>Manipulation</capacity><offset>-0.20</offset></li></capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity><label>immobilized</label>
        <capMods><li><capacity>Moving</capacity><setMax>0.1</setMax></li><li><capacity>Manipulation</capacity><setMax>0.5</setMax></li></capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
