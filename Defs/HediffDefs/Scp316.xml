<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SCP_316Desaturation</defName><label>SCP-316 desaturation</label>
    <description>The subject sees no colors and responds with increasing slowness and apathy. Continued exposure leaves them temporarily unable to fight or work.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><maxSeverity>1</maxSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>120000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages>
      <li><label>fading colors</label><statOffsets><WorkSpeedGlobal>-0.2</WorkSpeedGlobal></statOffsets></li>
      <li><minSeverity>0.67</minSeverity><label>apathetic</label>
        <statOffsets><WorkSpeedGlobal>-0.5</WorkSpeedGlobal></statOffsets>
        <capMods><li><capacity>Moving</capacity><offset>-0.3</offset></li></capMods>
      </li>
      <li><minSeverity>1</minSeverity><label>pacified</label>
        <statOffsets><WorkSpeedGlobal>-0.8</WorkSpeedGlobal></statOffsets>
        <capMods><li><capacity>Moving</capacity><setMax>0.1</setMax></li></capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
