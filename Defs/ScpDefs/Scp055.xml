<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScpFoundation.Definitions.ScpDef>
    <defName>SCP_Anomaly055</defName><label>SCP-055</label>
    <description>A self-keeping secret whose identifying information cannot remain in human memory.</description>
    <scpId>SCP-055</scpId><objectClass>Keter</objectClass>
    <tags><li>Antimemetic</li><li>Memory-affecting</li></tags>
    <requirements>
      <li Class="ScpFoundation.Containment.RequirementRoom"><id>room</id><minCells>25</minCells><roofed>true</roofed></li>
      <li Class="ScpFoundation.Containment.RequirementWallMaterial"><id>walls</id><allowedMaterials><li>SCP_Concrete</li></allowedMaterials><allowedWallDefs><li>SCP_FoundationWall</li><li>SCP_FoundationWallReinforced</li></allowedWallDefs></li>
      <li Class="ScpFoundation.Containment.RequirementDoor"><id>door</id><allowedDoorDefs><li>SCPV1_DoorB_Closed</li></allowedDoorDefs><requireClosed>true</requireClosed></li>
    </requirements>
    <breach><graceTicks>5000</graceTicks><deterministicAfterTicks>15000</deterministicAfterTicks><riskPerDay>8</riskPerDay><recoveryPerDay>16</recoveryPerDay></breach>
    <breachEffects>
      <li Class="ScpFoundation.Runtime.BreachEffectLetter"><bodyKey>SCP_055Breach</bodyKey></li>
    </breachEffects>
    <research><observedWork>30000</observedWork><partialWork>150000</partialWork><fullWork>360000</fullWork>
      <observedReportKey>SCP_055Observed</observedReportKey><partialReportKey>SCP_055Partial</partialReportKey><documentedReportKey>SCP_055Documented</documentedReportKey>
      <experimentReportKeys><li>SCP_055Experiment1</li><li>SCP_055Experiment2</li><li>SCP_055Experiment3</li></experimentReportKeys>
    </research>
    <source><title>SCP-055</title><author>qntm and CptBellman</author><url>https://scp-wiki.wikidot.com/scp-055</url><license>CC BY-SA 3.0</license></source>
  </ScpFoundation.Definitions.ScpDef>
</Defs>
