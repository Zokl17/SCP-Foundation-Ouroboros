    <description>Isolated fleshcrafting sects whose rites reshape bone, blood and living tissue. This placeholder currently uses conventional melee-focused outlander raids without mutations.</description>
    <fixedName>Sarkic Cults</fixedName>
    <pawnSingular>Sarkic cultist</pawnSingular><pawnsPlural>Sarkic cultists</pawnsPlural>
    <categoryTag>SCPSarkicCults</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>9</configurationListOrderPriority><settlementGenerationWeight>0.28</settlementGenerationWeight>
    <techLevel>Industrial</techLevel><basicMemberKind>SCP_SarkicCultist</basicMemberKind>
    <fixedLeaderKinds><li>SCP_SarkicCultist</li></fixedLeaderKinds>
    <leaderTitle>cult elder</leaderTitle><leaderTitleFemale>cult elder</leaderTitleFemale>
    <permanentEnemy>false</permanentEnemy>
    <colorSpectrum><li>(0.38,0.08,0.17)</li><li>(0.60,0.14,0.25)</li></colorSpectrum>
    <pawnGroupMakers Inherit="False">
      <li><kindDef>Combat</kindDef><options><SCP_SarkicCultist>12</SCP_SarkicCultist></options></li>
      <li><kindDef>Peaceful</kindDef><options><SCP_SarkicCultist>10</SCP_SarkicCultist></options></li>
      <li><kindDef>Trader</kindDef><traders><SCP_SarkicQuartermaster>1</SCP_SarkicQuartermaster></traders><carriers><Muffalo>5</Muffalo></carriers><guards><SCP_SarkicCultist>12</SCP_SarkicCultist></guards></li>
      <li><kindDef>Settlement</kindDef><options><SCP_SarkicCultist>12</SCP_SarkicCultist><SCP_SarkicQuartermaster>1</SCP_SarkicQuartermaster></options></li>
    </pawnGroupMakers>
  </FactionDef>

  <FactionDef ParentName="OutlanderRoughBase">
    <defName>SCP_SerpentsHand</defName>
    <label>Serpent's Hand</label>
    <description>A decentralized anomalous movement opposed to the imprisonment of sapient and benign anomalies. This hidden placeholder is reserved for future portal and liberation incidents.</description>
    <fixedName>Serpent's Hand</fixedName>
    <pawnSingular>Hand member</pawnSingular><pawnsPlural>Hand members</pawnsPlural>
    <categoryTag>SCPSerpentsHand</categoryTag>
    <requiredCountAtGameStart>0</requiredCountAtGameStart><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <settlementGenerationWeight>0</settlementGenerationWeight><hidden>true</hidden><displayInFactionSelection>false</displayInFactionSelection>
    <canSiege>false</canSiege><canStageAttacks>false</canStageAttacks>
    <naturalEnemy>false</naturalEnemy><permanentEnemy>false</permanentEnemy>
    <techLevel>Industrial</techLevel><basicMemberKind>SCP_SerpentsHandAdept</basicMemberKind>
    <pawnGroupMakers Inherit="False"><li><kindDef>Combat</kindDef><options><SCP_SerpentsHandAdept>10</SCP_SerpentsHandAdept></options></li></pawnGroupMakers>
  </FactionDef>
</Defs>
