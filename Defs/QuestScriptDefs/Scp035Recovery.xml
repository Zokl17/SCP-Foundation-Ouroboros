<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <QuestScriptDef>
    <defName>SCP_035Recovery</defName>
    <rootSelectionWeight>0.12</rootSelectionWeight><rootMinPoints>400</rootMinPoints>
    <expireDaysRange>5~9</expireDaysRange>
    <questNameRules><rulesStrings><li>questName->Recover SCP-035</li></rulesStrings></questNameRules>
    <questDescriptionRules><rulesStrings>
      <li>questDescription->The Foundation has traced a porcelain mask to a lone wanderer near your colony. Witnesses report that the wearer attacks anyone who approaches, while their body visibly decomposes. The mask itself seems to call to anyone who sees it. Find the wearer, recover SCP-035 and bring it home for containment. Avoid prolonged visual contact.</li>
    </rulesStrings></questDescriptionRules>
    <root Class="QuestNode_Sequence"><nodes>
      <li Class="QuestNode_GetMap" />
      <li Class="QuestNode_GetSiteTile"><storeAs>siteTile</storeAs><preferCloserTiles>true</preferCloserTiles></li>
      <li Class="ScpFoundation.Storytelling.QuestNode_Scp035SiteSetup" />
      <li Class="QuestNode_GetDefaultSitePartsParams">
        <tile>$siteTile</tile><faction>$siteFaction</faction>
        <sitePartDefs>$sitePartDefs</sitePartDefs><storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
      </li>
      <li Class="QuestNode_GenerateSite">
        <sitePartsParams>$sitePartsParams</sitePartsParams><faction>$siteFaction</faction>
        <tile>$siteTile</tile><storeAs>site</storeAs><worldObjectDef>SCP_035MaskedHostSite</worldObjectDef>
      </li>
      <li Class="QuestNode_SpawnWorldObjects"><worldObjects>$site</worldObjects></li>
      <li Class="ScpFoundation.Storytelling.QuestNode_Scp035TrackRecovery" />
      <li Class="ScpFoundation.Storytelling.QuestNode_RecordScpArrival"><number>035</number></li>
      <li Class="QuestNode_WorldObjectTimeout">
        <worldObject>$site</worldObject><isQuestTimeout>true</isQuestTimeout>
        <delayTicks>1200000</delayTicks><inSignalDisable>site.MapGenerated</inSignalDisable>
        <destroyOnCleanup>false</destroyOnCleanup>
        <node Class="QuestNode_End"><outcome>Fail</outcome></node>
      </li>
      <li Class="QuestNode_Signal"><inSignal>Scp035Recovered</inSignal>
        <node Class="QuestNode_Sequence"><nodes>
          <li Class="QuestNode_Letter"><label TKey="SCP_035RecoveredTitle">SCP-035 recovered</label><text TKey="SCP_035RecoveredBody">The mask has reached your colony. Secure it immediately and keep personnel from looking at it.</text></li>
          <li Class="QuestNode_End"><outcome>Success</outcome></li>
        </nodes></node>
      </li>
      <li Class="QuestNode_Signal"><inSignal>Scp035Lost</inSignal><node Class="QuestNode_End"><outcome>Fail</outcome></node></li>
    </nodes></root>
  </QuestScriptDef>
</Defs>
