<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SitePartDef>
    <defName>SCP_CollectorEstate</defName><label>collector's estate</label>
    <description>An obsessed collector keeps several anomalous objects in a guarded house.</description>
