  </WorldObjectDef>
  <MapGeneratorDef>
    <defName>SCP_CollectorEstateMap</defName>
    <genSteps><li>ElevationFertility</li><li>Terrain</li><li>SCP_CollectorEstate</li>
      <li>FindPlayerStartSpot</li><li>Fog</li></genSteps>
  </MapGeneratorDef>
  <GenStepDef>
    <defName>SCP_CollectorEstate</defName><order>400</order>
    <genStep Class="ScpFoundation.Storytelling.GenStep_ScpCollectorEstate" />
