<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SitePartDef ParentName="Outpost">
    <defName>SCP_882Workshop</defName>
    <label>SCP-882 recovery site</label>
    <description>The Chaos Insurgency found SCP-882 and occupied an abandoned workshop. Retake the site and recover the object.</description>
    <approachOrderString>Attack {0}</approachOrderString>
    <approachingReportString>Attacking {0}.</approachingReportString>
    <arrivedLetter>The Chaos Insurgency found SCP-882 and occupied this abandoned workshop. Defeat the guards and recover the object for containment.</arrivedLetter>
    <minMapSize>(250, 1, 250)</minMapSize>
    <tags Inherit="False"><li>SCP882Workshop</li></tags>
  </SitePartDef>

  <WorldObjectDef ParentName="Site">
    <defName>SCP_882WorkshopSite</defName>
    <label>SCP-882 recovery site</label>
    <worldObjectClass>ScpFoundation.Storytelling.Scp882WorkshopSite</worldObjectClass>
    <overrideMapSize>(250, 1, 250)</overrideMapSize>
    <mapGenerator>SCP_882SavedMap</mapGenerator>
  </WorldObjectDef>

  <!-- No procedural terrain, ruins, plants or animals may run over the snapshot. -->
  <MapGeneratorDef>
    <defName>SCP_882SavedMap</defName>
    <genSteps>
      <li>SCP_882Workshop</li>
      <li>FindPlayerStartSpot</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>SCP_882Workshop</defName>
    <order>400</order>
    <genStep Class="ScpFoundation.Storytelling.GenStep_Scp882Workshop" />
  </GenStepDef>
</Defs>
