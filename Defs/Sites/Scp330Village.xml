<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SitePartDef>
    <defName>SCP_330Village</defName>
    <label>SCP-330 village</label>
    <description>A village whose residents worship a reliquary and display unexplained changes to their hands and movement.</description>
    <workerClass>SitePartWorker</workerClass>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
    <requiresFaction>true</requiresFaction>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <approachOrderString>Investigate {0}</approachOrderString>
    <approachingReportString>Investigating {0}.</approachingReportString>
    <arrivedLetter>The villagers are peaceful for now. They will attack after one day, or sooner if the reliquary is disturbed. Recover the object and leave.</arrivedLetter>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <minMapSize>(250, 1, 250)</minMapSize>
    <tags><li>SCP330Village</li></tags>
  </SitePartDef>
  <WorldObjectDef ParentName="Site">
    <defName>SCP_330VillageSite</defName>
    <label>SCP-330 village</label>
    <worldObjectClass>ScpFoundation.Storytelling.Scp330VillageSite</worldObjectClass>
    <overrideMapSize>(250, 1, 250)</overrideMapSize>
    <mapGenerator>SCP_330SavedMap</mapGenerator>
  </WorldObjectDef>
  <MapGeneratorDef>
    <defName>SCP_330SavedMap</defName>
    <genSteps><li>SCP_330Village</li><li>FindPlayerStartSpot</li><li>Fog</li></genSteps>
  </MapGeneratorDef>
  <GenStepDef>
    <defName>SCP_330Village</defName><order>400</order>
    <genStep Class="ScpFoundation.Storytelling.GenStep_Scp330Village" />
  </GenStepDef>
</Defs>
