      <li Class="StockGenerator_SingleDef"><thingDef>SCP_FoundationNetLauncher</thingDef><countRange>0~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SCP_Nu7Armor</thingDef><countRange>0~1</countRange></li>
