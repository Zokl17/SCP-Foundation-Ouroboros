<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    MC&D is represented as a rare independent orbital contact. It deliberately
    has no FactionDef: the company does not create settlements or ordinary
    caravans and enters the normal orbital-trader pool directly.
  -->
  <TraderKindDef>
    <defName>SCP_Orbital_MarshallCarterDark</defName>
    <label>Marshall, Carter and Dark brokerage</label>
    <description>A discreet Marshall, Carter and Dark brokerage offering restricted technology, unusual medicine and carefully sourced armaments to clients able to pay.</description>
    <orbital>true</orbital>
    <requestable>false</requestable>
    <commonality>0.35</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef"><thingDef>Silver</thingDef><countRange>8000~14000</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>150~450</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>5~14</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>MedicineUltratech</thingDef><countRange>8~20</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Luciferium</thingDef><countRange>4~12</countRange></li>

      <li Class="StockGenerator_SingleDef"><thingDef>SCP_ClassAAmnestic</thingDef><countRange>3~8</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SCP_MnesticStabilizer</thingDef><countRange>3~8</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SCP_HemostaticInjector</thingDef><countRange>4~10</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SCP_Nu7HKCarbine</thingDef><countRange>0~2</countRange></li>
