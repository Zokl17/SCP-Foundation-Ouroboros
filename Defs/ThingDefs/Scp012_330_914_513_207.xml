<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>SCP_012Score</defName><label>SCP-012 unfinished score</label>
    <description>Blood-written sheet music. In visible light, human observers are compelled to approach and bleed onto it.</description>
    <thingClass>ThingWithComps</thingClass><category>Item</category><altitudeLayer>Item</altitudeLayer>
    <tickerType>Rare</tickerType><selectable>true</selectable><stackLimit>1</stackLimit>
    <alwaysHaulable>true</alwaysHaulable><designateHaulable>false</designateHaulable><rotatable>false</rotatable>
    <graphicData><texPath>Things/Item/ScpArtifacts/Scp012</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.0,0.9)</drawSize></graphicData>
    <statBases><MaxHitPoints>80</MaxHitPoints><Mass>0.2</Mass><MarketValue>0</MarketValue><Flammability>1</Flammability></statBases><tradeability>None</tradeability>
    <comps>
      <li Class="ScpFoundation.Runtime.CompProperties_Scp"><anomaly>SCP_Anomaly012</anomaly><requireCapture>true</requireCapture></li>
      <li Class="ScpFoundation.Interactions.CompProperties_ScpInteraction" />
      <li Class="ScpFoundation.Anomalies.CompProperties_Scp012" />
    </comps>
  </ThingDef>
