    <techLevel>Spacer</techLevel>
    <graphicData><texPath>Things/Item/Apparel/ScpGocWhiteHelmet</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>Cutout</shaderType><drawSize>(0.95,0.95)</drawSize></graphicData>
    <statBases>
      <MarketValue>2100</MarketValue><MaxHitPoints>420</MaxHitPoints><Mass>2.5</Mass><Flammability>0.25</Flammability>
      <ArmorRating_Sharp>1.38</ArmorRating_Sharp><ArmorRating_Blunt>0.575</ArmorRating_Blunt><ArmorRating_Heat>0.69</ArmorRating_Heat>
      <Insulation_Cold>5</Insulation_Cold><Insulation_Heat>3</Insulation_Heat><EquipDelay>6</EquipDelay>
    </statBases>
    <thingCategories><li>ApparelArmor</li></thingCategories>
    <costList><Steel>35</Steel><Plasteel>45</Plasteel><ComponentIndustrial>5</ComponentIndustrial><ComponentSpacer>1</ComponentSpacer></costList>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity><bodyPartGroups><li>FullHead</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/GocWhiteHelmet/GocWhiteHelmet</wornGraphicPath>
      <drawData>
        <scale>0.725</scale>
        <dataSouth><offset>(0,0,-0.07)</offset></dataSouth>
        <dataNorth><offset>(0,0,-0.07)</offset></dataNorth>
        <dataEast><offset>(0.04,0,-0.08)</offset></dataEast>
        <dataWest><offset>(-0.04,0,-0.08)</offset></dataWest>
      </drawData>
      <layers><li>Overhead</li></layers><tags Inherit="False"><li>SCP_GocWhiteSuit</li></tags>
      <defaultOutfitTags><li>Soldier</li><li>Spacefarer</li></defaultOutfitTags><useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options"><options><li><only>(1,1,1)</only></li></options></colorGenerator>
    <tradeTags><li>HiTechArmor</li><li>Armor</li></tradeTags>
  </ThingDef>
</Defs>
