<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="SCPV1_VisualBase"><defName>SCPV1_EmergencyAccumulator</defName><designationCategory>SCPFoundation</designationCategory><passability>PassThroughOnly</passability><uiOrder>975</uiOrder><label>Foundation emergency accumulator</label><description>Emergency backup for the connected power network during solar flares. Toggle between Foundation equipment only and all electric appliances on that network, regardless of rooms. Stores up to 12 hours of operation. Draws 200 W while charging and 50 W when full. Switched-off or broken devices, generators and other emergency accumulators are not supplied by the reserve.</description><tickerType>Normal</tickerType><rotatable>false</rotatable><terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded><statBases><MaxHitPoints>260</MaxHitPoints><WorkToBuild>3000</WorkToBuild><Flammability>0</Flammability></statBases><costList><Steel>100</Steel><ComponentIndustrial>6</ComponentIndustrial></costList><comps><li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>200</basePowerConsumption><shortCircuitInRain>true</shortCircuitInRain></li><li Class="CompProperties_Flickable" /><li Class="ScpFoundation.Interactions.CompProperties_EmergencyAccumulator" /></comps><graphicData><texPath>Things/Building/Containment/ScpEmergencyAccumulator</texPath><graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated><drawSize>(1,1)</drawSize></graphicData></ThingDef>
</Defs>
