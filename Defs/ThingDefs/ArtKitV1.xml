  <ThingDef ParentName="DoorBase">
    <defName>SCPV1_Shutter_Closed</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <uiOrder>500</uiOrder>
    <label>Foundation blast shutter</label>
    <description>A massive two-cell containment bulkhead with interlocking teeth and blinking movement lights. In automatic mode it behaves as a door until any SCP on the map breaches containment, then closes and blocks passage. Manual mode provides explicit open and close controls. Loss of power is fail-closed.</description>
    <thingClass>ScpFoundation.Runtime.Building_FoundationShutter</thingClass>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <stuffCategories IsNull="True" />
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>SCP_FoundationReinforcedContainment</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>1800</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>5000</WorkToBuild>
      <DoorOpenSpeed>0.18</DoorOpenSpeed>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/Building/Shutter/ScpBlastBulkhead_Closed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1.5)</drawSize>
      <drawRotated>false</drawRotated>
      <shadowData>
        <volume>(2.8,1.25,0.9)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
      <damageData><enabled>false</enabled></damageData>
    </graphicData>
    <uiIconPath>Things/Building/Shutter/ScpBlastBulkhead_Closed</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <building>
      <isAirtight>true</isAirtight>
      <isSupportDoor>true</isSupportDoor>
      <doorSupportGraphic>
        <texPath>Things/Building/Shutter/ScpBlastBulkhead_Transparent</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(2,1)</drawSize>
        <drawRotated>true</drawRotated>
      </doorSupportGraphic>
      <doorTopGraphic>
        <texPath>Things/Building/Shutter/ScpBlastBulkhead_Transparent</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(2,1)</drawSize>
        <drawRotated>true</drawRotated>
      </doorTopGraphic>
      <blueprintGraphicData Inherit="False">
        <texPath>Things/Building/Shutter/ScpBlastBulkhead_Closed</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(3,1.5)</drawSize>
        <drawOffset>(0,0,0.18)</drawOffset>
        <drawRotated>false</drawRotated>
      </blueprintGraphicData>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="ScpFoundation.Runtime.CompProperties_FoundationShutter" />
    </comps>
    <placeWorkers>
      <li>PlaceWorker_MultiCellDoor</li>
    </placeWorkers>
  </ThingDef>
