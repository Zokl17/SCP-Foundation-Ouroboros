  <ThingDef ParentName="SCPV1_VisualBase">
    <defName>SCPV1_AccessTerminal</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <passability>PassThroughOnly</passability>
    <uiOrder>800</uiOrder>
    <label>Foundation communications terminal</label>
    <description>Contact the Foundation and read the shared correspondence archive. Sending and receiving requires a powered terminal on a home map. The archive remains available without power. Does not grant SCP clearance or start ending operations.</description>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="ScpFoundation.Interactions.CompProperties_FoundationAccessTerminal" />
    </comps>
    <graphicData>
      <texPath>Things/Building/ScpFoundationAccessTerminal</texPath>
      <drawRotated>false</drawRotated>
    </graphicData>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
  </ThingDef>
  <ThingDef ParentName="SCPV1_VisualBase">
    <defName>SCPV1_MonitoringConsole</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <passability>PassThroughOnly</passability>
    <uiOrder>900</uiOrder>
    <label>Foundation monitoring console</label>
    <size>(3,2)</size>
      <description>A staffed console with three base monitoring channels. Each powered Foundation monitoring display linked within eight cells adds two channels. Eligible objects connect automatically while standing on their bound posts; camera and operator status are checked separately. Remote observation must be permitted by the object's protocol.</description>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="ScpFoundation.Interactions.CompProperties_MonitoringConsole" />
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>SCPV1_MonitoringDisplay</li>
        </linkableFacilities>
      </li>
    </comps>
    <graphicData>
      <texPath>Things/Building/ScpFoundationMonitoringConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawRotated>false</drawRotated>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/ScpFoundationMonitoringConsole</uiIconPath>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>
  <ThingDef ParentName="SCPV1_VisualBase">
    <defName>SCPV1_MonitoringDisplay</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <passability>PassThroughOnly</passability>
    <uiOrder>950</uiOrder>
    <label>Foundation monitoring display</label>
    <description>A large powered display that automatically links to a nearby Foundation monitoring console within eight cells and direct line of sight. Adds two monitoring channels while powered. Its screens glow with the vanilla television effect while an operator works at the linked console.</description>
    <tickerType>Normal</tickerType>
    <size>(2,1)</size>
    <defaultPlacingRot>South</defaultPlacingRot>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <fillPercent>0.35</fillPercent>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>120</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="ScpFoundation.Interactions.CompProperties_MonitoringDisplay" />
      <li Class="CompProperties_Facility">
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>8</maxDistance>
        <requiresLOS>true</requiresLOS>
      </li>
    </comps>
    <graphicData>
      <texPath>Things/Building/Monitoring/ScpFoundationMonitoringDisplay</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawRotated>false</drawRotated>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/Monitoring/ScpFoundationMonitoringDisplay</uiIconPath>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>
  <ThingDef ParentName="SCPV1_VisualBase">
    <defName>SCPV1_Camera</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <passability>Standable</passability>
