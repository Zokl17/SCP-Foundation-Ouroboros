<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Legacy visual kit. Glass, camera and monitoring console now have functional integration. -->
  <ThingDef Name="SCPV1_VisualBase" ParentName="BuildingBase" Abstract="True">
    <description>ART v1 visual test sample. No SCP, access, monitoring or containment functionality.</description>
    <thingClass>Building</thingClass>
    <tickerType>Never</tickerType>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <passability>Impassable</passability>
    <fillPercent>0.5</fillPercent>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1,1)</drawSize>
      <drawRotated>true</drawRotated>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <MarketValue>0</MarketValue>
    </statBases>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <filthLeaving IsNull="True" />
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>
  <ThingDef Name="SCPV1_WallBase" ParentName="SCPV1_VisualBase" Abstract="True">
    <drawStyleCategory>Walls</drawStyleCategory>
    <graphicData>
      <linkFlags>
        <li>Wall</li>
      </linkFlags>
    </graphicData>
    <fillPercent>1</fillPercent>
    <blockLight>true</blockLight>
    <coversFloor>true</coversFloor>
    <holdsRoof>true</holdsRoof>
    <building>
      <isWall>true</isWall>
    </building>
  </ThingDef>
  <ThingDef ParentName="SCPV1_WallBase">
    <defName>SCPV1_WallA</defName>
    <label>ART v1: primary wall</label>
    <graphicData>
      <texPath>Things/Building/ScpContainmentWall_A</texPath>
    </graphicData>
  </ThingDef>
  <ThingDef ParentName="SCPV1_WallBase">
    <defName>SCPV1_WallB</defName>
    <label>ART v1: high-security wall</label>
    <graphicData>
      <texPath>Things/Building/ScpContainmentWall_B</texPath>
    </graphicData>
  </ThingDef>
  <ThingDef ParentName="SCPV1_WallBase">
    <defName>SCPV1_GlassWall</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <uiOrder>220</uiOrder>
    <label>armored observation glass</label>
    <description>Sealed structural glass: supports roofs and blocks movement and projectiles. Foundation observers and cameras can see through it.</description>
    <blockLight>false</blockLight>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <coversFloor>false</coversFloor>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <costList>
      <Steel>15</Steel>
    </costList>
    <thingClass>ScpFoundation.Runtime.Building_FoundationWall</thingClass>
    <graphicData Inherit="False">
      <texPath>Things/Building/Linked/ScpFoundationGlass_ClearCap47</texPath>
      <graphicClass>ScpFoundation.Runtime.Graphic_FoundationWall</graphicClass>
      <drawSize>(1,1)</drawSize>
      <drawRotated>false</drawRotated>
      <shaderType>Transparent</shaderType>
      <linkType>None</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Linked/ScpFoundationGlass_ClearCap47_Icon</uiIconPath>
    <building>
      <supportsWallAttachments>true</supportsWallAttachments>
      <blueprintGraphicData Inherit="False">
        <texPath>Things/Building/Linked/ScpFoundationGlass_ClearCap47_Blueprint</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <linkType>CornerFiller</linkType>
        <linkFlags>
          <li>Wall</li>
          <li>Rock</li>
        </linkFlags>
      </blueprintGraphicData>
    </building>
  </ThingDef>
  <!-- Full-tile Closed/Open art is not the split mover graphic used by Building_Door. -->
  <ThingDef Name="SCPV1_ClosedBase" ParentName="SCPV1_VisualBase" Abstract="True">
    <fillPercent>1</fillPercent>
    <blockLight>true</blockLight>
    <coversFloor>true</coversFloor>
    <description>Fixed CLOSED visual sample. Not a working door; place its OPEN sample separately for comparison.</description>
  </ThingDef>
  <ThingDef Name="SCPV1_OpenBase" ParentName="SCPV1_VisualBase" Abstract="True">
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <description>Fixed OPEN visual sample. Walkable test tile, without opening animation, seals or access control.</description>
  </ThingDef>
  <ThingDef ParentName="DoorBase">
    <defName>SCPV1_DoorA_Closed</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <uiOrder>300</uiOrder>
    <label>reinforced Foundation door</label>
    <description>A reinforced single-cell sliding door. Opens for allowed pawns and closes after passage. Uses 50 W; manual operation is slower. Supports hold-open and forbid controls. Not a hermetic interlocked airlock.</description>
    <thingClass>ScpFoundation.Runtime.Building_FoundationDoor</thingClass>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <stuffCategories IsNull="True" />
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>700</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>1800</WorkToBuild>
      <DoorOpenSpeed>0.8</DoorOpenSpeed>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/Building/Door/ScpReinforcedDoorA_ClosedRaised</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.8,1.35)</drawSize>
      <drawRotated>false</drawRotated>
      <shadowData>
        <volume>(1.7,0.85,0.75)</volume>
        <offset>(0,0,-0.04)</offset>
      </shadowData>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Door/ScpReinforcedDoorA_ClosedRaised</uiIconPath>
    <building>
      <blueprintGraphicData Inherit="False">
        <texPath>Things/Building/Door/ScpReinforcedDoorA_ClosedRaised</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1.8,1.35)</drawSize>
        <drawOffset>(0,0,0.16)</drawOffset>
        <drawRotated>false</drawRotated>
      </blueprintGraphicData>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="ScpFoundation.Runtime.CompProperties_FoundationDoorAccess" />
    </comps>
  </ThingDef>
