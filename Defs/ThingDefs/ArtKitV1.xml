  <ThingDef ParentName="DoorBase">
    <defName>SCPV1_DoorB_Closed</defName>
    <designationCategory>SCPFoundation</designationCategory>
    <uiOrder>310</uiOrder>
    <label>armored Foundation door</label>
    <description>A heavy two-cell armored door with two sliding leaves and a fixed steel frame. Requires supporting walls on both sides. Uses 100 W; manual operation is slower. Supports hold-open and forbid controls. Not a hermetic interlocked airlock.</description>
    <thingClass>ScpFoundation.Runtime.Building_FoundationMultiTileDoor</thingClass>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <stuffCategories IsNull="True" />
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>3600</WorkToBuild>
      <DoorOpenSpeed>0.55</DoorOpenSpeed>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/Building/Door/ScpArmoredDoorB_ClosedRaised</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1.5)</drawSize>
      <drawRotated>false</drawRotated>
      <shadowData>
        <volume>(2.8,1.05,0.85)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Door/ScpArmoredDoorB_ClosedRaised</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <building>
      <blueprintClass>Blueprint_Build</blueprintClass>
      <blueprintGraphicData Inherit="False">
        <texPath>Things/Building/Door/ScpArmoredDoorB_ClosedRaised</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(3,1.5)</drawSize>
        <drawOffset>(0,0,0.18)</drawOffset>
        <drawRotated>false</drawRotated>
      </blueprintGraphicData>
      <isSupportDoor>true</isSupportDoor>
      <doorTopHorizontalOffset>(0,0,0)</doorTopHorizontalOffset>
      <doorTopVerticalOffset>(0,0,0)</doorTopVerticalOffset>
      <doorSupportGraphic>
        <texPath>Things/Building/Door/ScpArmoredDoorB_Transparent</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(3,1.5)</drawSize>
        <drawRotated>true</drawRotated>
      </doorSupportGraphic>
      <doorTopGraphic>
        <texPath>Things/Building/Door/ScpArmoredDoorB_Transparent</texPath>
