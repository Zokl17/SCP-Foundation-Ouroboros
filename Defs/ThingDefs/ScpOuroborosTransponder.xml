<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>SCP_OuroborosTransponder</defName>
    <label>sealed signal transponder</label>
    <description>A sealed recording module extracted from the deserted signal relay. Bring it home, then select a colonist and right-click the module to decrypt it at a research bench. The result opens a separate Foundation assignment.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <graphicData><texPath>Things/Item/ScpArtifacts/ScpRelayRecorder</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.7</drawSize></graphicData>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <selectable>true</selectable>
    <statBases><MaxHitPoints>200</MaxHitPoints><Mass>0.3</Mass><MarketValue>0</MarketValue><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <comps>
      <li Class="CompProperties_Usable">
        <compClass>CompUseableDatacore</compClass>
        <useJob>SCP_OuroborosReadTransponder</useJob>
        <useLabel>Decrypt signal transponder</useLabel>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
      <li Class="CompProperties_UseEffectGiveQuest"><quest>SCP_OuroborosSignalResearch</quest></li>
    </comps>
  </ThingDef>
</Defs>
