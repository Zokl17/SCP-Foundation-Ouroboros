<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>SCP_882Core</defName><label>SCP-882 reservoir</label>
    <description>A legacy two-by-two SCP-882 reservoir, now filled with full-strength seawater. Existing chambers remain usable after updating the mod.</description>
    <thingClass>ScpFoundation.Anomalies.Building_Scp882Tank</thingClass><size>(2,2)</size><tickerType>Rare</tickerType><selectable>true</selectable>
    <building><deconstructible>false</deconstructible></building>
    <passability>Impassable</passability><fillPercent>1</fillPercent><rotatable>false</rotatable>
    <graphicData><texPath>Things/Item/Scp882TankEmpty</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(2.5,2.5)</drawSize></graphicData>
    <statBases><MaxHitPoints>900</MaxHitPoints><Mass>100</Mass><WorkToBuild>4500</WorkToBuild><Flammability>0</Flammability><MarketValue>0</MarketValue></statBases>
    <costList><WoodLog>80</WoodLog><Cloth>30</Cloth><SCP_Concrete>40</SCP_Concrete><ComponentIndustrial>4</ComponentIndustrial></costList>
    <tradeability>None</tradeability>
    <comps><li Class="ScpFoundation.Anomalies.CompProperties_Scp882"><seawaterPercent>100</seawaterPercent><raidGrowthThreshold>10</raidGrowthThreshold></li></comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>SCP_882CoreFull</defName><label>SCP-882 reservoir</label>
    <description>A two-by-two reservoir of full-strength seawater. Carry SCP-882 here, inspect its rust each day, and replace its cotton ropes. Inspection restores exposed rust.</description>
    <thingClass>ScpFoundation.Anomalies.Building_Scp882Tank</thingClass><size>(2,2)</size><tickerType>Rare</tickerType><selectable>true</selectable>
    <building><deconstructible>false</deconstructible></building>
    <designationCategory>SCPFoundation</designationCategory><uiOrder>1212</uiOrder>
    <researchPrerequisites><li>SCP_882Reservoir</li></researchPrerequisites>
    <passability>Impassable</passability><fillPercent>1</fillPercent><rotatable>false</rotatable>
    <graphicData><texPath>Things/Item/Scp882TankEmpty</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(2.5,2.5)</drawSize></graphicData>
    <statBases><MaxHitPoints>900</MaxHitPoints><Mass>100</Mass><WorkToBuild>4500</WorkToBuild><Flammability>0</Flammability><MarketValue>0</MarketValue></statBases>
    <costList><WoodLog>80</WoodLog><Cloth>30</Cloth><SCP_Concrete>40</SCP_Concrete><ComponentIndustrial>4</ComponentIndustrial></costList>
    <tradeability>None</tradeability>
    <comps><li Class="ScpFoundation.Anomalies.CompProperties_Scp882"><seawaterPercent>100</seawaterPercent><raidGrowthThreshold>10</raidGrowthThreshold></li></comps>
  </ThingDef>
  <ThingDef>
    <defName>SCP_882Object</defName><label>SCP-882</label>
    <description>A rusted mechanism made of metal parts.</description>
    <thingClass>ThingWithComps</thingClass><category>Item</category><altitudeLayer>Item</altitudeLayer>
    <tickerType>Rare</tickerType><selectable>true</selectable><stackLimit>1</stackLimit>
    <alwaysHaulable>false</alwaysHaulable><designateHaulable>false</designateHaulable><rotatable>false</rotatable>
    <graphicData><texPath>Things/Item/Scp882</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.3,1.3)</drawSize></graphicData>
    <statBases><MaxHitPoints>500</MaxHitPoints><Mass>25</Mass><Flammability>0</Flammability><MarketValue>0</MarketValue></statBases>
    <tradeability>None</tradeability>
    <comps><li Class="ScpFoundation.Anomalies.CompProperties_Scp882"><seawaterPercent>0</seawaterPercent><raidGrowthThreshold>10</raidGrowthThreshold></li></comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>SCP_882GearGrowth</defName><label>SCP-882 gear growth</label>
    <description>Metal assimilated into SCP-882's expanding machinery.</description>
    <building><claimable>false</claimable><deconstructible>false</deconstructible></building>
    <graphicData><texPath>Things/Mote/Scp882MetalFragments</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(0.9,0.9)</drawSize></graphicData>
    <passability>Impassable</passability><fillPercent>0.7</fillPercent><rotatable>false</rotatable>
    <statBases><MaxHitPoints>180</MaxHitPoints><Flammability>0</Flammability><MarketValue>0</MarketValue></statBases>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>SCP_882GearGrowthQuarter</defName><label>SCP-882 assimilated fragment</label>
    <description>A small permanent cluster of metal incorporated into SCP-882.</description>
    <building><claimable>false</claimable><deconstructible>false</deconstructible></building>
    <graphicData><texPath>Things/Mote/Scp882MetalFragments</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(0.7,0.7)</drawSize></graphicData>
    <passability>Standable</passability><fillPercent>0.1</fillPercent><rotatable>false</rotatable>
    <statBases><MaxHitPoints>90</MaxHitPoints><Flammability>0</Flammability><MarketValue>0</MarketValue></statBases>
  </ThingDef>
  <ThingDef ParentName="BaseMechanoidWalker">
    <defName>SCP_882MetalHumanoid</defName><label>SCP-882 metal humanoid</label>
    <description>A hostile figure assembled from the metal drawn into SCP-882. It attacks intruders with heavy iron claws.</description>
    <!-- Keep the mechanical chassis, but do not inherit Biotech overseer control. -->
    <comps Inherit="False">
      <li><compClass>CompAttachBase</compClass></li>
      <li Class="CompProperties_CanBeDormant"><compClass>CompMechanoid</compClass></li>
      <li Class="CompProperties_WakeUpDormant"><wakeUpOnDamage>true</wakeUpOnDamage><wakeUpCheckRadius>30</wakeUpCheckRadius><wakeUpSound>MechanoidsWakeUp</wakeUpSound></li>
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="CompProperties_MechRepairable" />
    </comps>
    <graphicData><texPath>Things/Pawn/Scp882/MetalHumanoid</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(1.35,1.35)</drawSize></graphicData>
    <inspectorTabs Inherit="False"><li>ITab_Pawn_Health</li></inspectorTabs>
    <statBases><MoveSpeed>4.2</MoveSpeed><ArmorRating_Sharp>0.55</ArmorRating_Sharp><ArmorRating_Blunt>0.25</ArmorRating_Blunt><MarketValue>0</MarketValue></statBases>
    <tools Inherit="False">
      <li><label>left iron claw</label><labelNoLocation>iron claw</labelNoLocation><capacities><li>Cut</li></capacities><power>17</power><cooldownTime>2</cooldownTime><linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup><alwaysTreatAsWeapon>true</alwaysTreatAsWeapon></li>
      <li><label>right iron claw</label><labelNoLocation>iron claw</labelNoLocation><capacities><li>Cut</li></capacities><power>17</power><cooldownTime>2</cooldownTime><linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup><alwaysTreatAsWeapon>true</alwaysTreatAsWeapon></li>
    </tools>
    <race><body>Human</body><baseHealthScale>1.4</baseHealthScale><hasCorpse>false</hasCorpse></race>
  </ThingDef>
  <PawnKindDef ParentName="BaseMechanoidKind">
    <defName>SCP_882MetalHumanoid</defName><label>SCP-882 metal humanoid</label>
    <race>SCP_882MetalHumanoid</race><combatPower>180</combatPower>
    <appearsRandomlyInCombatGroups>false</appearsRandomlyInCombatGroups>
    <allowInMechClusters>false</allowInMechClusters>
    <canBeScattered>false</canBeScattered>
    <lifeStages>
      <li MayRequire="Ludeon.RimWorld.Biotech"><bodyGraphicData><texPath>Things/Pawn/Scp882/MetalHumanoid</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(1.35,1.35)</drawSize></bodyGraphicData></li>
      <li><bodyGraphicData><texPath>Things/Pawn/Scp882/MetalHumanoid</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(1.35,1.35)</drawSize></bodyGraphicData></li>
    </lifeStages>
  </PawnKindDef>
  <ThingDef Name="SCP882FragmentMoteBase" ParentName="MoteBase" Abstract="True">
