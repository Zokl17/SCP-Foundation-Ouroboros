  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>SCP_ScrambleVisor</defName>
    <label>SCRAMBLE visual-protection visor</label>
    <description>A helmet-mounted optical array issued to Foundation response teams. Four low-light lenses feed a hardened processor that detects and disrupts hazardous visual patterns before they reach the wearer. The targeting overlay improves weapon handling, while its filtered image offers limited protection from cognitohazardous and psychic influence.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ScpScrambleVisor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>0.85</drawSize>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>SCP_FoundationSpecialArmament</researchPrerequisite>
