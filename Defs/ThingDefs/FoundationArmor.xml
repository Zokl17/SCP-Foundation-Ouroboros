<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>SCP_FoundationAssaultVest</defName>
    <label>Foundation assault vest</label>
    <description>A compact high-collared ballistic vest issued to Foundation tactical personnel. Textured graphite-gray fabric, visible armor plates and an integrated three-pouch load-bearing rig provide practical protection without the weight of the heavier Nu-7 armor package.</description>
    <techLevel>Industrial</techLevel>
    <graphicData><texPath>Things/Item/Apparel/ScpFoundationAssaultVest</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>Cutout</shaderType></graphicData>
    <recipeMaker><researchPrerequisite>SCP_FoundationTacticalArmor</researchPrerequisite><unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef><skillRequirements><Crafting>4</Crafting></skillRequirements><recipeUsers Inherit="False"><li>SCP_FoundationCoreBench</li></recipeUsers><displayPriority>209</displayPriority></recipeMaker>
    <statBases>
      <WorkToMake>12000</WorkToMake><MarketValue>760</MarketValue><MaxHitPoints>330</MaxHitPoints><Mass>7.2</Mass><Flammability>0.45</Flammability>
      <ArmorRating_Sharp>0.92</ArmorRating_Sharp><ArmorRating_Blunt>0.40</ArmorRating_Blunt><ArmorRating_Heat>0.46</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold><Insulation_Heat>1</Insulation_Heat><EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets><MoveSpeed>-0.08</MoveSpeed></equippedStatOffsets>
    <thingCategories><li>ApparelArmor</li></thingCategories>
    <costList><Cloth>45</Cloth><Steel>35</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <apparel>
      <bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/FoundationAssaultVest/FoundationAssaultVest</wornGraphicPath>
      <layers><li>Middle</li><li>Shell</li></layers><tags><li>SCP_FoundationArmor</li></tags><defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options"><options><li><only>(1,1,1)</only></li></options></colorGenerator>
    <tradeTags><li>Armor</li></tradeTags>
  </ThingDef>

  <ThingDef ParentName="ArmorMachineableBase">
    <defName>SCP_Nu7Armor</defName>
    <label>Nu-7 tactical armor</label>
    <description>A modular tactical armor package issued to Nu-7 operators. It combines rigid torso and shoulder plates with a high collar, magazine rig, utility pouches and a hanging groin protector. Its protection exceeds a normal flak vest, but the extra coverage and carried equipment add weight.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ScpNu7Armor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>0.95</drawSize>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>SCP_FoundationTacticalArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements><Crafting>7</Crafting></skillRequirements>
      <recipeUsers Inherit="False"><li>SCP_FoundationCoreBench</li></recipeUsers>
