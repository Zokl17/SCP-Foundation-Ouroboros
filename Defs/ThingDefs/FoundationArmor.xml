      <tags><li>SCP_FoundationArmor</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options"><options><li><only>(1,1,1)</only></li></options></colorGenerator>
    <tradeTags><li>Armor</li></tradeTags>
  </ThingDef>

