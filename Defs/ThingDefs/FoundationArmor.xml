      <displayPriority>212</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>18000</WorkToMake><MaxHitPoints>100</MaxHitPoints><Mass>0.8</Mass>
      <ArmorRating_Sharp>0.04</ArmorRating_Sharp><ArmorRating_Blunt>0.02</ArmorRating_Blunt><ArmorRating_Heat>0.05</ArmorRating_Heat>
