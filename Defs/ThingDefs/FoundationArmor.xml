    </recipeMaker>
    <statBases>
      <WorkToMake>24000</WorkToMake><MaxHitPoints>450</MaxHitPoints><Mass>7.5</Mass><Flammability>0.45</Flammability>
      <ArmorRating_Sharp>1.166</ArmorRating_Sharp><ArmorRating_Blunt>0.495</ArmorRating_Blunt><ArmorRating_Heat>0.594</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold><Insulation_Heat>1</Insulation_Heat><EquipDelay>7</EquipDelay>
    </statBases>
    <equippedStatOffsets><MoveSpeed>-0.15</MoveSpeed></equippedStatOffsets>
