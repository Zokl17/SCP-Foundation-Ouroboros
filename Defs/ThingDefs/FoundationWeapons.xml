  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>SCP_FoundationTranqRifle</defName>
    <label>Foundation tranquilizer rifle</label>
    <description>A precision pneumatic rifle for capturing living subjects with minimal tissue damage. Its darts build up a fast-acting sedative in organic targets: a human-sized subject normally collapses after three hits, while larger creatures require proportionally more. The compound has no effect on mechanoids.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ScpFoundationTranqRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses><li>LongShots</li></weaponClasses>
    <recipeMaker>
