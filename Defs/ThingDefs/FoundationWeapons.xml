      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <recipeUsers Inherit="False"><li>SCP_FoundationArmoryModule</li></recipeUsers><displayPriority>210</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>28000</WorkToMake><MarketValue>520</MarketValue><Mass>3.8</Mass>
      <AccuracyTouch>0.60</AccuracyTouch><AccuracyShort>0.88</AccuracyShort>
      <AccuracyMedium>0.92</AccuracyMedium><AccuracyLong>0.78</AccuracyLong>
