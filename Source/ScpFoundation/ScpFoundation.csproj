<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AssemblyName>ScpFoundation</AssemblyName>
    <RootNamespace>ScpFoundation</RootNamespace>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</RimWorldDir>
    <ManagedDir>$(RimWorldDir)\RimWorldWin64_Data\Managed</ManagedDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\1.6\Assemblies</OutputPath>
  </PropertyGroup>
  <UsingTask TaskName="Csc" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll" />
  <ItemGroup>
    <Compile Include="Definitions\*.cs;Containment\*.cs;Runtime\*.cs;Knowledge\*.cs;Debugging\*.cs;Properties\*.cs;Storytelling\*.cs;Interactions\*.cs;Anomalies\*.cs" />
    <Reference Include="$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\System.dll;$(ManagedDir)\System.Core.dll;$(ManagedDir)\Assembly-CSharp.dll;$(ManagedDir)\UnityEngine.CoreModule.dll;$(ManagedDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="$(MSBuildProjectDirectory)\..\..\1.6\Assemblies\0Harmony.dll" />
  </ItemGroup>
  <ItemGroup><Reference Include="$(ManagedDir)\Unity.Mathematics.dll" /></ItemGroup>
  <ItemGroup><Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" /></ItemGroup>
  <ItemGroup><Reference Include="$(ManagedDir)\System.Xml.dll" /></ItemGroup>
  <Target Name="Build">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="RimWorld assembly not found. Set RimWorldDir to the game directory." />
    <MakeDir Directories="$(OutputPath)" />
    <Csc Sources="@(Compile)" References="@(Reference)" OutputAssembly="$(OutputPath)\$(AssemblyName).dll" TargetType="Library" NoStandardLib="true" NoConfig="true" Optimize="true" WarningLevel="4" TreatWarningsAsErrors="true" />
  </Target>
</Project>
