<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SCP_WeaponEnemyAnalysis</defName>
    <label>enemy analysis</label>
    <description>An enemy analysis computer has identified weaknesses in this target. The analysis is bound to one weapon and fades after one hour without another hit.</description>
    <hediffClass>ScpFoundation.Interactions.Hediff_WeaponAnalysis</hediffClass>
    <initialSeverity>0.05</initialSeverity><maxSeverity>0.15</maxSeverity>
    <stages><li /></stages>
  </HediffDef>
  <HediffDef>
    <defName>SCP_WeaponTracerMark</defName>
    <label>tracer mark</label>
    <description>Tracer impacts make this target easier to track for the shooter's allies.</description>
    <hediffClass>ScpFoundation.Interactions.Hediff_WeaponTracer</hediffClass>
    <initialSeverity>1</initialSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks></li></comps>
    <stages><li /></stages>
  </HediffDef>
  <HediffDef>
    <defName>SCP_WeaponCryoSlow</defName>
    <label>cryogenic slowdown</label>
    <description>Cryogenic ammunition is slowing movement.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><initialSeverity>1</initialSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks></li></comps>
    <stages><li><statOffsets><MoveSpeed>-0.80</MoveSpeed></statOffsets></li></stages>
  </HediffDef>
  <HediffDef>
    <defName>SCP_WeaponFlashConcealment</defName>
    <label>flash-hidden</label>
    <description>The shooter fired without a visible muzzle flash and is harder to track in darkness for a short time.</description>
    <hediffClass>HediffWithComps</hediffClass><initialSeverity>1</initialSeverity>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks></li></comps>
    <stages><li /></stages>
  </HediffDef>
</Defs>
