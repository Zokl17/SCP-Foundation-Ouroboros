  <WeaponTraitDef><defName>SCP_ThermalSight</defName><label>thermal sight</label><description>Negates the darkness penalty to ranged aim.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Sighted</weaponCategory><exclusionTags><li>Sights</li></exclusionTags><traitAdjectives><li>thermal</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>ThermalSight</effect></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_MotionPredictor</defName><label>motion predictor</label><description>An AI module improves aim against moving targets.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Sighted</weaponCategory><exclusionTags><li>Sights</li></exclusionTags><traitAdjectives><li>predictive</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>MovingTargetAccuracy</effect><magnitude>1.20</magnitude></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_EnemyAnalysis</defName><label>enemy analysis</label><description>The onboard computer analyzes an enemy after each hit. Repeated hits by this weapon exploit weak points for up to 15% extra damage; analysis expires after one hour.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Analysis</li></exclusionTags><traitAdjectives><li>analytical</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>EnemyAnalysis</effect></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_FriendlyFireLock</defName><label>friend-or-foe lock</label><description>Rejects shots that would hit an allied pawn.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Safety</li></exclusionTags><traitAdjectives><li>safe</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>FriendlyFireLock</effect></li></modExtensions></WeaponTraitDef>
