<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Workshop-only traits: no random rolls on Odyssey unique weapons. -->
  <WeaponTraitDef><defName>SCP_LaserTargetingUnit</defName><label>laser targeting unit</label><description>Improves close-range aim and helps track moving targets.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Ranged</weaponCategory><exclusionTags><li>Laser</li></exclusionTags><statFactors><AccuracyTouch>1.10</AccuracyTouch><AccuracyShort>1.10</AccuracyShort></statFactors><traitAdjectives><li>laser-guided</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>MovingTargetAccuracy</effect><magnitude>1.15</magnitude></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_CarbonInserts</defName><label>carbon inserts</label><description>A lighter frame that improves movement while the weapon is equipped.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Ranged</weaponCategory><exclusionTags><li>Weight</li></exclusionTags><statFactors><Mass>0.80</Mass></statFactors><equippedStatOffsets><MoveSpeed>0.10</MoveSpeed></equippedStatOffsets><traitAdjectives><li>carbon-framed</li></traitAdjectives></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_LightTrigger</defName><label>light trigger</label><description>Faster aiming at the cost of long-range precision.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Trigger</li></exclusionTags><statOffsets><RangedWeapon_WarmupMultiplier>-0.12</RangedWeapon_WarmupMultiplier></statOffsets><statFactors><AccuracyLong>0.94</AccuracyLong></statFactors><traitAdjectives><li>hair-trigger</li></traitAdjectives></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_Compensator</defName><label>compensator</label><description>A heavier muzzle device that improves close and medium range accuracy.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Muzzle</li></exclusionTags><statFactors><AccuracyShort>1.08</AccuracyShort><AccuracyMedium>1.08</AccuracyMedium></statFactors><statOffsets><Mass>0.20</Mass></statOffsets><traitAdjectives><li>compensated</li></traitAdjectives></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_FoldingStock</defName><label>folding stock</label><description>Faster to aim, but less accurate at long range.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Stock</li></exclusionTags><statOffsets><RangedWeapon_WarmupMultiplier>-0.08</RangedWeapon_WarmupMultiplier><Mass>-0.10</Mass></statOffsets><statFactors><AccuracyLong>0.90</AccuracyLong></statFactors><traitAdjectives><li>compact</li></traitAdjectives></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_WeightedStock</defName><label>weighted stock</label><description>Steadier shots with a heavier, slower weapon.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Stock</li></exclusionTags><statFactors><AccuracyShort>1.10</AccuracyShort><AccuracyMedium>1.10</AccuracyMedium></statFactors><statOffsets><Mass>0.60</Mass><RangedWeapon_WarmupMultiplier>0.08</RangedWeapon_WarmupMultiplier></statOffsets><traitAdjectives><li>weighted</li></traitAdjectives></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_Bipod</defName><label>bipod</label><description>Improves accuracy while the shooter holds position; adds weight.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Rifle</weaponCategory><exclusionTags><li>Support</li></exclusionTags><statOffsets><Mass>0.50</Mass></statOffsets><traitAdjectives><li>braced</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>StationaryAccuracy</effect><magnitude>1.18</magnitude></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_PrecisionBolt</defName><label>precision bolt</label><description>The first shot of a burst is more accurate, but follow-up shots are slower.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>FireControl</li></exclusionTags><burstShotSpeedMultiplier>0.80</burstShotSpeedMultiplier><traitAdjectives><li>precision-tuned</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>FirstShotAccuracy</effect><magnitude>1.18</magnitude></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_FireSelector</defName><label>fire selector</label><description>Switch between single shots and the weapon's normal burst.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>BurstFire</weaponCategory><exclusionTags><li>FireControl</li></exclusionTags><traitAdjectives><li>select-fire</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>FireSelector</effect></li></modExtensions></WeaponTraitDef>
