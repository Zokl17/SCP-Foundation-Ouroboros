  <WeaponTraitDef><defName>SCP_Bayonet</defName><label>bayonet</label><description>Improves melee damage with this gun, at the cost of aim speed.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>MeleeAttachment</li></exclusionTags><statOffsets><RangedWeapon_WarmupMultiplier>0.05</RangedWeapon_WarmupMultiplier></statOffsets><traitAdjectives><li>bayoneted</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>Bayonet</effect><magnitude>1.35</magnitude></li></modExtensions></WeaponTraitDef>
  <WeaponTraitDef><defName>SCP_Suppressor</defName><label>suppressor</label><description>Mutes the firing sound but slightly reduces effective range.</description><commonality>0.001</commonality><canGenerateAlone>false</canGenerateAlone><weaponCategory>Gun</weaponCategory><exclusionTags><li>Muzzle</li></exclusionTags><statOffsets><RangedWeapon_RangeMultiplier>-0.05</RangedWeapon_RangeMultiplier></statOffsets><traitAdjectives><li>suppressed</li></traitAdjectives><modExtensions><li Class="ScpFoundation.Interactions.ScpWeaponTraitExtension"><effect>Suppressor</effect></li></modExtensions></WeaponTraitDef>
