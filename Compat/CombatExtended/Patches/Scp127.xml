<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>SCP_127Gun</defName>
    <statBases>
      <Mass>2.8</Mass><RangedWeapon_Cooldown>0.42</RangedWeapon_Cooldown>
      <SightsEfficiency>1.1</SightsEfficiency><ShotSpread>0.09</ShotSpread><SwayFactor>1.1</SwayFactor><Bulk>6</Bulk>
    </statBases>
    <Properties>
      <recoilAmount>0.8</recoilAmount><verbClass>ScpFoundation.CombatExtendedCompat.Verb_Scp127ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand><defaultProjectile>SCP_127Tooth</defaultProjectile>
      <warmupTime>0.75</warmupTime><range>23.9</range>
      <burstShotCount>6</burstShotCount><ticksBetweenBurstShots>7</ticksBetweenBurstShots>
      <soundCast>Shot_MachinePistol</soundCast><soundCastTail>GunTail_Light</soundCastTail><muzzleFlashScale>5</muzzleFlashScale>
    </Properties>
    <AmmoUser><magazineSize>60</magazineSize><reloadTime>1</reloadTime><ammoSet>SCP_AmmoSet_127Teeth</ammoSet></AmmoUser>
    <FireModes><aimedBurstShotCount>1</aimedBurstShotCount><aiUseBurstMode>true</aiUseBurstMode><aiAimMode>AimedShot</aiAimMode></FireModes>
  </Operation>
  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/ThingDef[defName="SCP_127Gun"]/comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]</xpath>
    <attribute>Class</attribute><value>ScpFoundation.CombatExtendedCompat.CompProperties_Scp127Ammo</value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="SCP_127Gun"]/verbs/li[verbClass="ScpFoundation.Anomalies.Verb_Scp127Shoot"]</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SCP_127Tooth"]</xpath>
    <value><thingClass>CombatExtended.BulletCE</thingClass></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_127Tooth"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>Bullet</damageDef><damageAmountBase>120</damageAmountBase>
        <armorPenetrationSharp>270</armorPenetrationSharp><armorPenetrationBlunt>0</armorPenetrationBlunt>
        <speed>168</speed><suppressionFactor>0.2</suppressionFactor>
      </projectile>
    </value>
  </Operation>
</Patch>
