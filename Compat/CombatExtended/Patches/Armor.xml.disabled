<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- CE armor ratings are millimeters of RHA, not vanilla percentages.
       Explicit Bulk/WornBulk also keeps these definitions out of apparel auto-conversion. -->

  <!-- Foundation high-collar plate carrier. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_FoundationAssaultVest"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>8</Bulk><WornBulk>4</WornBulk><ArmorRating_Sharp>12</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_FoundationAssaultVest"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>18</ArmorRating_Blunt></value>
  </Operation>

  <!-- Nu-7 armor and helmet. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_Nu7Armor"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>10</Bulk><WornBulk>6</WornBulk><ArmorRating_Sharp>15</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_Nu7Armor"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>24</ArmorRating_Blunt></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_Nu7Helmet"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>4</Bulk><WornBulk>1.5</WornBulk><ArmorRating_Sharp>10</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_Nu7Helmet"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>14</ArmorRating_Blunt></value>
  </Operation>

  <!-- Chaos plate carrier and powered armor. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ChaosAssaultArmor"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>9</Bulk><WornBulk>5</WornBulk><ArmorRating_Sharp>13</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ChaosAssaultArmor"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>20</ArmorRating_Blunt></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ChaosHeavyExosuit"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>60</Bulk><WornBulk>12</WornBulk><ArmorRating_Sharp>20</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ChaosHeavyExosuit"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>36</ArmorRating_Blunt></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ChaosHeavyHelmet"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>5</Bulk><WornBulk>2</WornBulk><ArmorRating_Sharp>16</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ChaosHeavyHelmet"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>24</ArmorRating_Blunt></value>
  </Operation>

  <!-- GOC white powered armor. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_GocWhiteExosuit"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>65</Bulk><WornBulk>12</WornBulk><ArmorRating_Sharp>22</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_GocWhiteExosuit"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>42</ArmorRating_Blunt></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_GocWhiteHelmet"]/statBases/ArmorRating_Sharp</xpath>
    <value><Bulk>5</Bulk><WornBulk>2</WornBulk><ArmorRating_Sharp>18</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_GocWhiteHelmet"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>27</ArmorRating_Blunt></value>
  </Operation>
</Patch>
