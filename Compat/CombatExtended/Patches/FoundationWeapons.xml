    <researchPrerequisite>SCP_FoundationMedicalProtocols</researchPrerequisite>
  </Operation>

  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>SCP_FoundationNetLauncher</defName>
    <statBases>
      <Mass>5.6</Mass><RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
      <SightsEfficiency>0.9</SightsEfficiency><ShotSpread>0.12</ShotSpread><SwayFactor>1.35</SwayFactor><Bulk>12</Bulk><WorkToMake>34000</WorkToMake>
    </statBases>
    <Properties>
      <recoilAmount>1.8</recoilAmount><verbClass>CombatExtended.Verb_ShootCE</verbClass><hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>SCP_ProjectileContainmentNet</defaultProjectile><warmupTime>0.8</warmupTime><range>22</range><burstShotCount>1</burstShotCount>
      <soundCast>Shot_Shotgun</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>2</muzzleFlashScale>
    </Properties>
    <AmmoUser><magazineSize>1</magazineSize><reloadTime>4.5</reloadTime><ammoSet>SCP_AmmoSet_ContainmentNet</ammoSet></AmmoUser>
    <FireModes><aiAimMode>Snapshot</aiAimMode></FireModes>
    <weaponTags><li>SCPFoundationNet</li></weaponTags>
    <researchPrerequisite>SCP_FoundationSpecialArmament</researchPrerequisite>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ProjectileEMPRifle"]/thingClass</xpath>
    <value><thingClass>ScpFoundation.CombatExtendedCompat.Projectile_FoundationEmpCE</thingClass></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ProjectileEMPRifle"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <speed>70</speed><damageDef>Bullet</damageDef><damageAmountBase>12</damageAmountBase><explosionRadius>1.75</explosionRadius>
        <armorPenetrationSharp>0</armorPenetrationSharp><armorPenetrationBlunt>0</armorPenetrationBlunt><suppressionFactor>0.25</suppressionFactor>
        <dangerFactor>0.15</dangerFactor><castShadow>true</castShadow>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ProjectileTranqDart"]/thingClass</xpath>
    <value><thingClass>ScpFoundation.CombatExtendedCompat.Projectile_TranqDartCE</thingClass></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ProjectileTranqDart"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <speed>65</speed><damageDef>Bullet</damageDef><damageAmountBase>1</damageAmountBase>
        <armorPenetrationSharp>0.2</armorPenetrationSharp><armorPenetrationBlunt>0.5</armorPenetrationBlunt><suppressionFactor>0</suppressionFactor><dangerFactor>0.05</dangerFactor>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ProjectileContainmentNet"]/thingClass</xpath>
    <value><thingClass>ScpFoundation.CombatExtendedCompat.Projectile_ContainmentNetCE</thingClass></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SCP_ProjectileContainmentNet"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <speed>38</speed><damageDef>Blunt</damageDef><damageAmountBase>2</damageAmountBase>
        <armorPenetrationSharp>0</armorPenetrationSharp><armorPenetrationBlunt>5</armorPenetrationBlunt><suppressionFactor>0.2</suppressionFactor><dangerFactor>0.1</dangerFactor>
      </projectile>
    </value>
  </Operation>
  <!-- CE patches vanilla parents before Verse resolves inheritance. Keep exactly
       one weapon-specific ammo/verb/fire-mode definition on each child.
       Restore the standard BaseHumanMakeableGun components explicitly. -->
  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/ThingDef[defName="SCP_Nu7HKCarbine" or defName="SCP_Nu7LightMachineGun" or defName="SCP_FoundationSpasTwelve" or defName="SCP_FoundationEMPRifle" or defName="SCP_FoundationTranqRifle" or defName="SCP_FoundationNetLauncher"]/comps</xpath>
    <attribute>Inherit</attribute><value>False</value>
  </Operation>
  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/ThingDef[defName="SCP_Nu7HKCarbine" or defName="SCP_Nu7LightMachineGun" or defName="SCP_FoundationSpasTwelve" or defName="SCP_FoundationEMPRifle" or defName="SCP_FoundationTranqRifle" or defName="SCP_FoundationNetLauncher"]/verbs</xpath>
    <attribute>Inherit</attribute><value>False</value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SCP_Nu7HKCarbine" or defName="SCP_Nu7LightMachineGun" or defName="SCP_FoundationSpasTwelve" or defName="SCP_FoundationEMPRifle" or defName="SCP_FoundationTranqRifle" or defName="SCP_FoundationNetLauncher"]/comps</xpath>
    <value>
      <li Class="CompProperties_Forbiddable"/>
      <li><compClass>CompEquippable</compClass></li>
      <li Class="CompProperties_Styleable"/>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponGun</nameMaker>
        <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li><compClass>CompQuality</compClass></li>
      <li Class="CompProperties_Biocodable"/>
    </value>
    <!-- Equippable must exist when CE initializes its cached verb/fire modes. -->
    <order>Prepend</order>
  </Operation>
</Patch>
