    </statBases>
    <Properties>
      <recoilAmount>1.20</recoilAmount><verbClass>CombatExtended.Verb_ShootCE</verbClass><hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_556x45mmNATO_FMJ</defaultProjectile><warmupTime>0.85</warmupTime><range>58</range>
